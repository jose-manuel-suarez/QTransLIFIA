# ==========================================
# CONFIGURACIÓN DEL MODO DE ENTRADA
# ==========================================
# QTRANS_INPUT_MODE: "batch" procesa los JSON del directorio (solo los indicados
# en QTRANS_INPUT_FILES si se definen); "algorithm" procesa un solo archivo
# definido en QTRANS_INPUT_FILE.
QTRANS_INPUT_MODE=batch

# ==========================================
# CONFIGURACIÓN DEL ALGORITMO DE ENTRADA A MIGRAR
# ==========================================
# QTRANS_INPUT_FILE: archivo JSON seleccionado en modo "algorithm"; puede pasarse
# también por CLI con --input-file.
QTRANS_INPUT_FILE=

# QTRANS_INPUT_FILES: lista separada por comas de archivos JSON (relativos a
# QTRANS_INPUT_DIR) restringe el modo "batch" a esos archivos; también por CLI
# con --input-files. Vacío = procesar todos los .json del directorio.
QTRANS_INPUT_FILES=

# ==========================================
# DIRECTORIOS DE TRABAJO (relativos a la raíz del proyecto)
# ==========================================
# QTRANS_INPUT_DIR: directorio de JSON de entrada.
QTRANS_INPUT_DIR=input

# QTRANS_OUTPUT_DIR: raíz de las corridas. Dentro se crea, por cada ejecución,
# una carpeta run_DD_MM_YYYY__HH (fecha y hora sin minutos).
QTRANS_OUTPUT_DIR=output

# QTRANS_RUN_LABEL: etiqueta explícita de la corrida. Vacío = automático
# (DD_MM_YYYY__HH). Ejecutar varias veces dentro de la misma hora reutiliza el
# directorio y sobrescribe los archivos; al cambiar la hora se crea uno nuevo.
QTRANS_RUN_LABEL=

# ==========================================
# CONFIGURACIÓN DE SALIDAS GENERADAS
# ==========================================
# QTRANS_CAPTURE_IMAGES: activa capturas PNG de Quirk. Booleano (true/false).
QTRANS_CAPTURE_IMAGES=true

# QTRANS_GENERATE_QASM_IMAGES: activa diagramas PNG de los circuitos OpenQASM. Booleano.
QTRANS_GENERATE_QASM_IMAGES=true

# QTRANS_GENERATE_COMPARISON: activa los informes Markdown de comparación Quirk/QASM. Booleano.
QTRANS_GENERATE_COMPARISON=true

# QTRANS_GENERATE_COMPOSER_IMAGES: activa las imágenes PNG de los circuitos migrados
# a Qiskit con el estilo de IBM Quantum Composer. Booleano.
QTRANS_GENERATE_COMPOSER_IMAGES=true

# QTRANS_GENERATE_ZX: activa la conversión y comparación de grafos ZX. Booleano.
QTRANS_GENERATE_ZX=true

# QTRANS_GENERATE_ZX_IMAGES: activa los diagramas SVG de los grafos ZX. Booleano.
QTRANS_GENERATE_ZX_IMAGES=true

# ==========================================
# CONFIGURACIÓN FUNCIONAL DE CONSOLA
# ==========================================
# QTRANS_VERBOSE: muestra el resultado de cada etapa del pipeline. Booleano.
# Activado por defecto; en el CLI puede desactivarse con --quiet.
QTRANS_VERBOSE=true

# ==========================================
# CONFIGURACIÓN DE VERSIÓN OBJETIVO DE OPENQASM
# ==========================================
# QTRANS_QASM_VERSION: formato fuente generado: "2.0" o "3.0". Los archivos se
# escriben con el sufijo de versión, p. ej. 1__Shor_v3.0.txt.
QTRANS_QASM_VERSION=3.0

# ==========================================
# CONFIGURACIÓN ADICIONAL DEL PIPELINE
# ==========================================
# QTRANS_ZX_TIME: snapshot temporal Quirk para gates como Rxft, en el rango 0..1.
QTRANS_ZX_TIME=0.5

# QTRANS_ZX_TIMEOUT: límite en segundos por comparación/reducción ZX; al excederse
# se marca "NO DEMOSTRADO (timeout)" en vez de colgar el pipeline. Entero positivo.
QTRANS_ZX_TIMEOUT=120

# QTRANS_SHOTS: número de shots para los QNodes PennyLane con mediciones. Entero positivo.
QTRANS_SHOTS=1000

# QTRANS_CAPTURE_TIMEOUT: timeout de carga/captura del navegador Selenium, en segundos. Entero positivo.
QTRANS_CAPTURE_TIMEOUT=15

# QTRANS_TARGET_PROVIDERS: lista separada por comas: "qiskit", "braket", "pennylane".
# Los scripts se generan en migrated_circuits/<prefijo>/, con prefijo ibm_qiskit,
# aws_braket o xanadu_pennylane respectivamente.
QTRANS_TARGET_PROVIDERS=qiskit

# QTRANS_PRESERVE_CUSTOM_GATES: si es true, las compuertas custom y las nativas de
# Quirk (p. ej. QFT) se conservan como funciones locales en los scripts migrados;
# si es false, se expanden en línea. Booleano. También por CLI con
# --preserve-custom-gates / --no-preserve-custom-gates.
QTRANS_PRESERVE_CUSTOM_GATES=true
