# ==========================================
# CONFIGURACIÓN DE LA LIBRERÍA (QTransLIFIA)
# ==========================================
# El paquete instalable solo expone translate_circuit / translate_circuits.
# Los valores por defecto del payload se parametrizan desde este archivo .env
# del directorio de trabajo actual.

# ==========================================
# CONFIGURACIÓN DE LA VERSIÓN OBJETIVO DE OPENQASM
# ==========================================
# QTRANS_QASM_VERSION: formato fuente generado: "2.0" o "3.0".
QTRANS_QASM_VERSION=3.0

# ==========================================
# CONFIGURACIÓN DEL PROVEEDOR OBJETIVO
# ==========================================
# QTRANS_TARGET_PROVIDERS: lista separada por comas: "qiskit", "braket", "pennylane".
# Con un único proveedor la librería genera el código migrado para ese proveedor
# (la clave default del payload es el primer de la lista).
QTRANS_TARGET_PROVIDERS=qiskit

# ==========================================
# CONFIGURACIÓN DE LAS COMPUERTAS CUSTOM
# ==========================================
# QTRANS_PRESERVE_CUSTOM_GATES: si es true, las compuertas custom y las nativas de
# Quirk (p. ej. QFT) se conservan como funciones locales en los scripts migrados;
# si es false, se expanden en línea. Booleano.
QTRANS_PRESERVE_CUSTOM_GATES=true

# ==========================================
# CONFIGURACIÓN FUNCIONAL
# ==========================================
# QTRANS_SHOTS: número de shots para los QNodes PennyLane con mediciones. Entero positivo.
QTRANS_SHOTS=1000

# QTRANS_ZX_TIME: snapshot temporal Quirk para gates como Rxft, en el rango 0..1.
QTRANS_ZX_TIME=0.5

# QTRANS_ZX_TIMEOUT: límite en segundos por comparación/reducción ZX; al excederse
# se marca "NO DEMOSTRADO (timeout)" en vez de colgar el pipeline. Entero positivo.
QTRANS_ZX_TIMEOUT=120

# QTRANS_GENERATE_ZX: activa la conversión y comparación de grafos ZX. Booleano.
QTRANS_GENERATE_ZX=true

# QTRANS_CAPTURE_TIMEOUT: timeout de captura/imagen del circuito Quirk (Selenium), en segundos. Entero positivo. Se utiliza sólo si se pide la imagen del circuito.
QTRANS_CAPTURE_TIMEOUT=15
