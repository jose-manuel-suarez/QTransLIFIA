# ==========================================
# CONFIGURACIÓN DEL MODO DE ENTRADA
# ==========================================
# QTRANS_INPUT_MODE: "batch" procesa todos los JSON del directorio;
# "algorithm" procesa un solo archivo definido en QTRANS_INPUT_FILE.
QTRANS_INPUT_MODE=algorithm

# ==========================================
# CONFIGURACIÓN DEL ALGORITMO DE ENTRADA A MIGRAR
# ==========================================
# QTRANS_INPUT_FILE: archivo JSON seleccionado en modo "algorithm";
# puede pasarse también por CLI.
QTRANS_INPUT_FILE=test_algorithm.json

# ==========================================
# CONFIGURACIÓN DE DIRECTORIOS DE ENTRADA Y SALIDA
# ==========================================
# QTRANS_INPUT_DIR: directorio de JSON de entrada.
QTRANS_INPUT_DIR=notebooks/input

# QTRANS_OUTPUT_DIR: raíz de los resultados del pipeline.
QTRANS_OUTPUT_DIR=notebooks/output

# QTRANS_QASM_DIR: archivos OpenQASM generados.
QTRANS_QASM_DIR=notebooks/algorithms_qasm

# QTRANS_VISUAL_DIR: raíz de las imágenes del proyecto; dentro de ella se crean
# los subdirectorios circuits_quirk, circuits_qasm y circuits_quirk_original.
QTRANS_VISUAL_DIR=/output/imgs

# QTRANS_QUIRK_IMAGES_DIR: capturas PNG de Quirk (default: QTRANS_VISUAL_DIR/circuits_quirk).
QTRANS_QUIRK_IMAGES_DIR=/output/imgs/circuits_quirk

# QTRANS_QASM_IMAGES_DIR: diagramas PNG de los circuitos OpenQASM (default: QTRANS_VISUAL_DIR/circuits_qasm).
QTRANS_QASM_IMAGES_DIR=/output/imgs/circuits_qasm

# QTRANS_COMPARE_DIR: informes Markdown de comparación visual.
QTRANS_COMPARE_DIR=notebooks/compare

# QTRANS_ZX_DIR: grafos, comparativas e imágenes ZX.
QTRANS_ZX_DIR=notebooks/ZXCalculus

# QTRANS_MIGRATED_DIR: raíz de los scripts por provider; crea un subdirectorio por provider.
QTRANS_MIGRATED_DIR=notebooks/output/migrated_circuits

# ==========================================
# CONFIGURACIÓN DE SALIDAS GENERADAS
# ==========================================
# QTRANS_CAPTURE_IMAGES: activa capturas de Quirk. Booleano (true/false).
QTRANS_CAPTURE_IMAGES=true

# QTRANS_GENERATE_QASM_IMAGES: activa diagramas de los circuitos QASM. Booleano.
QTRANS_GENERATE_QASM_IMAGES=true

# QTRANS_GENERATE_COMPARISON: activa páginas de comparación Quirk/QASM. Booleano.
QTRANS_GENERATE_COMPARISON=true

# QTRANS_GENERATE_ZX: activa conversión y comparación de grafos ZX. Booleano.
QTRANS_GENERATE_ZX=true

# QTRANS_GENERATE_ZX_IMAGES: activa diagramas SVG de grafos ZX. Booleano.
QTRANS_GENERATE_ZX_IMAGES=true

# ==========================================
# CONFIGURACIÓN FUNCIONAL DE CONSOLA
# ==========================================
# QTRANS_VERBOSE: muestra el resultado de cada etapa del pipeline. Booleano.
QTRANS_VERBOSE=false

# ==========================================
# CONFIGURACIÓN DE VERSIÓN OBJETIVO DE OPENQASM (2.0 o 3.0 actualmente)
# ==========================================
# QTRANS_QASM_VERSION: formato fuente generado: "2.0" o "3.0".
QTRANS_QASM_VERSION=3.0

# ==========================================
# CONFIGURACIÓN ADICIONAL DEL PIPELINE
# ==========================================
# QTRANS_ZX_TIME: snapshot temporal Quirk para gates como Rxft, en el rango 0..1.
QTRANS_ZX_TIME=0.5

# QTRANS_SHOTS: número de shots para los QNodes PennyLane con mediciones. Entero positivo.
QTRANS_SHOTS=1000

# QTRANS_CAPTURE_TIMEOUT: timeout de carga/captura del navegador Selenium, en segundos. Entero positivo.
QTRANS_CAPTURE_TIMEOUT=15

# QTRANS_TARGET_PROVIDERS: lista separada por comas: "ibm_qiskit", "aws_braket", "pennylane".
QTRANS_TARGET_PROVIDERS=ibm_qiskit
